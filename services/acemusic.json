{
  "service": "acemusic",
  "title": "ACE Music by Ace Data Cloud",
  "kind": "audio",
  "description": "Create songs from ideas or lyrics, import MP3 references, cover an owned track or blend two owned tracks.",
  "tool_prefix": "acedatacloud_single_acemusic",
  "generate_path": "/acemusic/audios",
  "task_path": "/acemusic/tasks",
  "defaults": {
    "action": "generate"
  },
  "generate_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "generate",
          "upload",
          "cover",
          "mashup"
        ]
      },
      "model": {
        "type": "string",
        "enum": [
          "acemusic-v1.1",
          "acemusic-v1"
        ]
      },
      "custom": {
        "type": "boolean"
      },
      "prompt": {
        "type": "string",
        "maxLength": 20000
      },
      "title": {
        "type": "string",
        "maxLength": 20000
      },
      "style": {
        "type": "string",
        "maxLength": 20000
      },
      "lyric": {
        "type": "string",
        "maxLength": 20000
      },
      "name": {
        "type": "string",
        "maxLength": 20000
      },
      "audio_id": {
        "type": "string",
        "maxLength": 20000
      },
      "audio_url": {
        "type": "string",
        "format": "uri",
        "maxLength": 20000
      },
      "mashup_audio_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 20000
        },
        "minItems": 2,
        "maxItems": 2
      },
      "asset_id": {
        "type": "string",
        "maxLength": 128
      },
      "asset_type": {
        "type": "string",
        "enum": [
          "midi",
          "image",
          "video"
        ]
      }
    }
  },
  "task_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "task_id"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "maxLength": 128,
        "pattern": "[A-Za-z0-9_-]+"
      },
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60
      }
    }
  },
  "generate_name": "acedatacloud_single_acemusic_generate",
  "tools": [
    "acedatacloud_single_acemusic_generate",
    "acedatacloud_single_acemusic_task",
    "acedatacloud_single_acemusic_upload_asset",
    "acedatacloud_single_acemusic_retrieve_assets"
  ],
  "toolset": "acedatacloud-single-acemusic",
  "asset_path": "/acemusic/assets",
  "asset_upload_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "url"
    ],
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "midi",
          "image",
          "video"
        ]
      },
      "url": {
        "type": "string",
        "format": "uri",
        "maxLength": 20000
      },
      "name": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "asset_query_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 128
      },
      "type": {
        "type": "string",
        "enum": [
          "midi",
          "image",
          "video"
        ]
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10001
      },
      "page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "repo": "ACEMusicHermes"
}
